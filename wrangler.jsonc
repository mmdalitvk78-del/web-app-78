{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app-78",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "ea22a813-54fb-45c1-8091-b5f187c904e5","database_name": "web-app-78" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "76b456308c7a4d909494f2c654753d69" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
